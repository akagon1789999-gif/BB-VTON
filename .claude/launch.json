{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-server",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8743"],
      "port": 8743
    },
    {
      "name": "flask-server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "ADMIN_PASSWORD=test1234 PORT=8010 DATA_DIR=/tmp/bb-admin-test python3 server.py"],
      "port": 8010
    },
    {
      "name": "fabric-studio",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "ADMIN_PASSWORD=test1234 PORT=8011 DATA_DIR=/tmp/bb-fabric-studio VTON_PROVIDER=mock FABRIC_STUDIO_DEBUG=true python3 server.py"],
      "port": 8011
    },
    {
      "name": "fabric-studio-live",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "set -a; . ./.env; set +a; PORT=8012 python3 server.py"],
      "port": 8012
    }
  ]
}
