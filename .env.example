FASHN_API_KEY=your_fashn_api_key_here
ADMIN_PASSWORD=choose_a_strong_admin_password
# Paystack keys, used for the ₦500 client-facing "Generate Video" charge.
# PAYSTACK_PUBLIC_KEY is safe to expose to the browser; PAYSTACK_SECRET_KEY must stay server-side only.
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# Optional: point at a mounted persistent volume so catalog uploads survive redeploys, e.g. /data
DATA_DIR=
