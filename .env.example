FASHN_API_KEY=your_fashn_api_key_here
ADMIN_PASSWORD=choose_a_strong_admin_password
# Paystack keys, used for the ₦500 client-facing "Generate Video" charge.
# PAYSTACK_PUBLIC_KEY is safe to expose to the browser; PAYSTACK_SECRET_KEY must stay server-side only.
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# Set to true to let testers generate videos for free, skipping the real Paystack charge.
# REMOVE or set to false before taking real payments — this bypasses billing entirely.
PAYMENT_TEST_MODE=false
# Optional: point at a mounted persistent volume so catalog uploads survive redeploys, e.g. /data
DATA_DIR=

# ---------------------------------------------------------------- Fabric Studio
# Which try-on engine to use: fashn_api (default) | mock | fashn_vton_15
# mock runs the whole workflow with no API credits, for development and tests.
VTON_PROVIDER=fashn_api
# How the garment reaches the model:
#   fabric   (default) send the fabric itself as the product image and describe the
#            outfit in the prompt — FASHN's recommendation for fabric-to-garment
#   template send a flat-lay we compose from the fabric and an outfit silhouette
#   edit     send the person with the fabric as image_context
# VTON_GARMENT_STRATEGY=fabric
# Optional model overrides.
# VTON_FABRIC_MODEL=tryon-max
# VTON_FAST_MODEL=tryon-v1.6
# VTON_QUALITY_MODEL=tryon-max
# VTON_EDIT_MODEL=edit
# VTON_RESOLUTION=1k
# VTON_TIMEOUT_SECONDS=240
# Self-hosted FASHN VTON 1.5 (used when VTON_PROVIDER=fashn_vton_15)
# FASHN_VTON15_URL=https://your-gpu-host
# FASHN_VTON15_TOKEN=
# Optional human-parsing service: noop (default) | remote
# SEGMENTATION_PROVIDER=noop
# SEGMENTATION_URL=
# SEGMENTATION_TOKEN=
# Catalogue importer: comma-separated hosts that may be fetched. Empty = off.
# FABRIC_IMPORT_ALLOWED_HOSTS=upload.wikimedia.org,images.example.com
# Include the technical detail in API error payloads (development only).
# FABRIC_STUDIO_DEBUG=false
