.env
__pycache__/
.DS_Store

# Local Netlify folder
.netlify

# Runtime catalog data (admin uploads) — persisted on disk, not in git
/catalog.json
/uploads/

# Runtime payment records for the paid video feature — persisted on disk, not in git
/payments.json

# Fabric Studio runtime data (catalogues, generated media, migration state).
# These live on the mounted DATA_DIR volume in production, not in git.
/fabric_catalog.json
/outfit_catalog.json
/fabric_generations.json
/fabric_studio_meta.json
/media/

# Studio uploads (the fabric and photo a visitor hands to tryon-max). Same
# story: they live on the mounted DATA_DIR volume, not in git.
/studio-uploads/

# PAI-EAS deploy credentials and the config rendered from the template.
deploy/pai-eas/.env.deploy
deploy/pai-eas/eas_config.json
deploy/pai-eas/tests/venv/
