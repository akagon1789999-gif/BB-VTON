# ---------------------------------------------------------------------------
# FASHN
# ---------------------------------------------------------------------------
# Required. Server-side only -- never prefix with NEXT_PUBLIC_.
FASHN_API_KEY=fa-xxxxxxxxxxxxxxxxxxxx
FASHN_API_BASE=https://api.fashn.ai/v1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# local  -> writes to ./.data/uploads, served back through /api/files/*
# s3     -> any S3-compatible bucket (AWS, R2, B2, MinIO)
STORAGE_DRIVER=local

# Public origin of this app. FASHN fetches hosted image URLs from the public
# internet, so a localhost origin is NOT reachable -- with STORAGE_DRIVER=local
# on localhost the app automatically falls back to data URIs. Point this at a
# tunnel (ngrok/cloudflared) or your deployed origin to use hosted URLs in dev.
APP_URL=http://localhost:3000

# S3 driver settings (only read when STORAGE_DRIVER=s3)
S3_BUCKET=fabric-studio
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for R2 / MinIO / any non-AWS endpoint. Leave blank for AWS S3.
S3_ENDPOINT=
# Public base URL objects are readable from (CDN domain or bucket website URL).
S3_PUBLIC_BASE_URL=
# Set to true for MinIO and other providers that need path-style addressing.
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Fabric mode
# ---------------------------------------------------------------------------
# tryon-max -> send the swatch as product_image with a retexture prompt
# edit      -> send the reference photo as the base and retexture via /edit
FABRIC_STRATEGY=tryon-max
