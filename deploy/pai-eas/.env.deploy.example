# Copy to .env.deploy, fill in, then:  set -a; . ./.env.deploy; set +a; ./deploy.sh
#
# .env.deploy is gitignored. Nothing here is ever baked into the image -- the
# container receives only the non-secret env listed in eas_config.template.json.

# --- Alibaba Cloud account -------------------------------------------------
# A RAM user scoped to PAI + OSS + ACR, not the root account keys.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# --- Container registry ----------------------------------------------------
# acr  = Alibaba Container Registry. EAS pulls over the VPC endpoint, no
#        credentials needed, fastest cold start. Needs an ACR instance:
#        Personal Edition requires an *individual*-type account, and
#        Enterprise Edition is a paid subscription.
# ghcr = GitHub Container Registry. Free, but the image pull crosses the
#        public internet on every cold start.
REGISTRY_KIND=ghcr

# --- if REGISTRY_KIND=ghcr -------------------------------------------------
# GHCR_OWNER is the GitHub user or org that owns the package. Lowercased
# automatically -- ghcr.io rejects uppercase in that path segment.
GHCR_OWNER=
GHCR_USERNAME=
# A classic PAT with write:packages (which implies read:packages). The same
# token is base64-encoded into the EAS config so EAS can pull the private
# image, so treat it as a production credential: scope it to packages only.
GHCR_TOKEN=

# --- if REGISTRY_KIND=acr --------------------------------------------------
ACR_NAMESPACE=
ACR_USERNAME=
# The ACR *instance* access password, set under Access Credentials in the ACR
# console. Not your account password.
ACR_PASSWORD=

# --- OSS ------------------------------------------------------------------
# Must be in the same region as the EAS service or the mount will be slow and
# billed as public egress.
OSS_BUCKET=

# --- Optional overrides ---------------------------------------------------
# REGION=cn-shanghai   # set REGION=ap-southeast-1 for Singapore
# SERVICE_NAME=fashn_vton_15
# INSTANCE_TYPE=ecs.gn7i-c8g1.2xlarge
# MAX_REPLICAS=3
# IMAGE_TAG=20260924-abc1234
# FASHN_VTON_REF=main
# OSS_WEIGHTS_PREFIX=fashn-vton-1.5/weights
# WEIGHTS_STAGING=/var/tmp/fashn-vton-weights

# Comma-separated hostnames the service may fetch image URLs from. Leave empty
# and it accepts any public address (still SSRF-guarded); set it in production.
# URL_ALLOWLIST=cdn.yourdomain.com,your-bucket.oss-cn-shanghai.aliyuncs.com
