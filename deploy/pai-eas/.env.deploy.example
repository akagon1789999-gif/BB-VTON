# Copy to .env.deploy, fill in, then:  set -a; . ./.env.deploy; set +a; ./deploy.sh
#
# .env.deploy is gitignored. Nothing here is ever baked into the image -- the
# container receives only the non-secret env listed in eas_config.template.json.

# --- Alibaba Cloud account -------------------------------------------------
# A RAM user scoped to PAI + OSS + ACR, not the root account keys.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# --- Container Registry (ACR) ---------------------------------------------
ACR_NAMESPACE=
ACR_USERNAME=
# The ACR *instance* access password, set under Access Credentials in the ACR
# console. Not your account password.
ACR_PASSWORD=

# --- OSS ------------------------------------------------------------------
# Must be in the same region as the EAS service or the mount will be slow and
# billed as public egress.
OSS_BUCKET=

# --- Optional overrides ---------------------------------------------------
# REGION=cn-shanghai
# SERVICE_NAME=fashn_vton_15
# INSTANCE_TYPE=ecs.gn7i-c8g1.2xlarge
# MAX_REPLICAS=3
# IMAGE_TAG=20260924-abc1234
# FASHN_VTON_REF=main
# OSS_WEIGHTS_PREFIX=fashn-vton-1.5/weights
# WEIGHTS_STAGING=/var/tmp/fashn-vton-weights

# Comma-separated hostnames the service may fetch image URLs from. Leave empty
# and it accepts any public address (still SSRF-guarded); set it in production.
# URL_ALLOWLIST=cdn.yourdomain.com,your-bucket.oss-cn-shanghai.aliyuncs.com
